# Copy this file to one named exactly ".env" (no .example) and paste your keys
# after the = signs. No quotes, no spaces. Leave a line blank to skip that source.
# The README explains where to get each key for free.

# TMDB (movies, TV shows, actors) - https://www.themoviedb.org/settings/api
# Either the short "API Key" or the long "API Read Access Token" works here.
TMDB_API_KEY=

# SerpAPI (Google Images) - https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Unsplash - https://unsplash.com/oauth/applications  (use the "Access Key")
UNSPLASH_ACCESS_KEY=

# Pexels - https://www.pexels.com/api/
PEXELS_API_KEY=

# Pixabay - https://pixabay.com/api/docs/  (key is shown on that page once logged in)
PIXABAY_API_KEY=
